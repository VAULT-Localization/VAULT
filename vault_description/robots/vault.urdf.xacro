<?xml version="1.0" ?>

<robot name="vault" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- Include macros -->
    <xacro:include filename="$(find vault_description)/urdf/inertials.xacro"/>
    <xacro:include filename="$(find vault_description)/urdf/materials.xacro"/>
    <xacro:include filename="$(find vault_description)/urdf/box/vault_box.urdf.xacro" />
    <xacro:include filename="$(find vault_description)/urdf/sensors/all_sensors.urdf.xacro" />
 
    <!-- The base link -->
    <link name="vault_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <box size="0.01 0.01 0.01"/>
            </geometry>
            <material name="orange" />
        </visual>
    </link>

    <gazebo reference="vault_link">
        <material>Gazebo/Orange</material>
    </gazebo>

    <!-- box -->
    <xacro:vault_box parent="vault_link" />

</robot>