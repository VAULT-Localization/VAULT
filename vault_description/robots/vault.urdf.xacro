<?xml version="1.0" ?>

<robot name="vault" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find vault_description)/urdf/vault.urdf.xacro"/>
    <xacro:include filename="$(find vault_description)/urdf/materials.xacro"/>

    <link name="base_link"/>
    <xacro:vault parent="base_link">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:vault>
</robot>