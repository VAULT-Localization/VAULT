<?xml version="1.0"?>
<robot name="vault_computer" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="vault_computer" params="parent">

        <xacro:property name="box_heigh" value="0.040" />
        <xacro:property name="box_width" value="0.110" />
        <xacro:property name="box_depth" value="0.110" />
        <xacro:property name="box_mass" value="0.500" />

        <link name="vault_computer_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <box size="${box_width} ${box_depth} ${box_heigh}"/>
                </geometry>
                <material name="white" />
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <box size="${box_width} ${box_depth} ${box_heigh}"/>
                </geometry>
            </collision>
            <xacro:solid_cuboid_inertial 
                rpy="0 0 0" xyz="0 0 0"
                mass="${box_mass}"
                x="${box_width}" y="${box_depth}" z="${box_heigh}" />
        </link>

        <gazebo reference="vault_computer_link">
            <material>Gazebo/White</material>
        </gazebo>

        <joint name="vault_computer_joint" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 0.014"/>
            <parent link="${parent}" />
            <child link="vault_computer_link" />
        </joint>

    </xacro:macro>
</robot>