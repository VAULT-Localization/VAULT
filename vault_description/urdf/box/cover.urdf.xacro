<?xml version="1.0"?>
<robot name="vault_cover" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="vault_cover" params="parent">

        <xacro:property name="box_heigh" value="0.003" />
        <xacro:property name="box_width" value="0.180" />
        <xacro:property name="box_depth" value="0.200" />
        <xacro:property name="box_mass" value="0.01" />

        <link name="vault_cover_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <box size="${box_width} ${box_depth} ${box_heigh}"/>
                </geometry>
                <material name="red" />
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <box size="${box_width} ${box_depth} ${box_heigh}"/>
                </geometry>
            </collision>
            <xacro:solid_cuboid_inertial 
                rpy="0 0 0" xyz="0 0 0"
                mass="${box_mass}"
                x="${box_width}" y="${box_depth}" z="${box_heigh}" />
        </link>

        <gazebo reference="vault_cover_link">
            <material>Gazebo/Red</material>
        </gazebo>

        <joint name="vault_cover_joint" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 -0.0895"/>
            <parent link="${parent}" />
            <child link="vault_cover_link" />
        </joint>

    </xacro:macro>
</robot>