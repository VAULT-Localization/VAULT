<?xml version="1.0"?>
<robot name="cover" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="box_heigh" value="0.0085" />
    <xacro:property name="box_width" value="0.168" />
    <xacro:property name="box_depth" value="0.173" />
    <xacro:property name="box_mass" value="0.1" />

    <xacro:macro name="cover" params="parent">

        <link name="cover_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="package://vault_description/meshes/box/cover.stl"  scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="red" />
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <box size="${box_width} ${box_depth} ${box_heigh}"/>
                </geometry>
            </collision>
            <xacro:solid_cuboid_inertial 
                rpy="0 0 0" xyz="0 0 0"
                mass="${box_mass}"
                x="${box_width}" y="${box_depth}" z="${box_heigh}" />
        </link>

        <gazebo reference="cover_link">
            <material>Gazebo/Red</material>
        </gazebo>

        <joint name="cover_joint" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <parent link="${parent}" />
            <child link="cover_link" />
        </joint>

    </xacro:macro>
</robot>