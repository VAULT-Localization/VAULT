<?xml version="1.0"?>
<robot name="vault_realsense_mount" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="vault_realsense_mount" params="parent">

        <xacro:property name="box_heigh" value="0.033" />
        <xacro:property name="box_width" value="0.080" />
        <xacro:property name="box_depth" value="0.030" />
        <xacro:property name="box_mass" value="0.1" />

        <link name="vault_realsense_mount_link">
            <visual>
                <origin rpy="0 0 0" xyz="0.002 0.069 -0.0675" />
                <geometry>
                    <mesh filename="package://vault_description/meshes/box/realsense_mount.stl"  scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="green" />
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <box size="${box_width} ${box_depth} ${box_heigh}"/>
                </geometry>
            </collision>
            <xacro:solid_cuboid_inertial 
                rpy="0 0 0" xyz="0 0 0"
                mass="${box_mass}"
                x="${box_width}" y="${box_depth}" z="${box_heigh}" />
        </link>

        <gazebo reference="vault_realsense_mount_link">
            <material>Gazebo/Green</material>
        </gazebo>

        <joint name="vault_realsense_mount_joint" type="fixed">
            <origin rpy="0 0 0" xyz="0 -0.0695 0.0075"/>
            <parent link="${parent}" />
            <child link="vault_realsense_mount_link" />
        </joint>

    </xacro:macro>
</robot>