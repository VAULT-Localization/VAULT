<?xml version="1.0"?>
<robot name="all_sensors" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
  <!-- Imu -->
  <xacro:include filename="$(find vault_description)/urdf/sensors/imu/imu.urdf.xacro" />  
  
  <!-- Hokuyo -->
  <xacro:include filename="$(find vault_description)/urdf/sensors/hokuyo/hokuyo.urdf.xacro" /> 

  <!-- GPS -->
  <xacro:include filename="$(find vault_description)/urdf/sensors/gps/gps.urdf.xacro" /> 
  <xacro:include filename="$(find vault_description)/urdf/sensors/gps/gps_board.urdf.xacro" /> 
  
  <!-- Realsense -->
  <xacro:include filename="$(find vault_description)/urdf/sensors/realsense/d435.urdf.xacro" /> 
  <xacro:include filename="$(find vault_description)/urdf/sensors/realsense/d435i.urdf.xacro" /> 
  
</robot>
