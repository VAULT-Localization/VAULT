<?xml version="1.0"?>
<robot name="sensor_gps" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sensor_gps" params="prefix parent *origin">
    <xacro:arg name="prefix" default=""/>

    <!-- antenna -->
    <joint name="${prefix}_antenna_joint" type="fixed">
        <axis xyz="1 0 0"/>
        <xacro:insert_block name="origin"/>
        <parent link="${parent}"/>
        <child link="${prefix}_antenna_link"/>
    </joint>
    
    <link name="${prefix}_antenna_link">
      <inertial>
        <mass value="0.001"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.060 0.060 0.025"/>
        </geometry>
        <material name="gray" />
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.060 0.060 0.025"/>
        </geometry>
      </collision>
    </link>
       
    <gazebo reference="${prefix}_antenna_link">
      <material>Gazebo/Grey</material>
    </gazebo>

    <!-- plugin -->
    <gazebo reference="${prefix}_antenna_link">
        <sensor name="gps_sensor" type="gps">
            <always_on>true</always_on>
            <update_rate>1.0</update_rate>
            <plugin name="gps_controller" filename="libgazebo_ros_gps_sensor.so">
                <ros>
                    <remapping>gps_controller/out:=gps</remapping>
                </ros>
                <frame_name>$(arg prefix)/${prefix}_antenna_link</frame_name>
            </plugin>
        </sensor>
        <material>Gazebo/Grey</material>
    </gazebo>

    
  </xacro:macro>

</robot>
