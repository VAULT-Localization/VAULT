<robot name="sensor_t265" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="t265_fisheye" params="name namespace reference_frame topic"> 
        <gazebo reference="${namespace}_${name}_link">
            <sensor name="${name}_${topic}" type="wideanglecamera">
                <camera>
                    <horizontal_fov>6.283</horizontal_fov>
                    <image>
                        <width>800</width>
                        <height>848</height>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                    <lens>
                        <type>custom</type>
                        <custom_function>
                            <c1>1.05</c1>
                            <c2>4</c2>
                            <f>1.0</f>
                            <fun>tan</fun>
                        </custom_function>
                        <scale_to_hfov>true</scale_to_hfov>
                        <cutoff_angle>${M_PI}</cutoff_angle>
                        <env_texture_size>512</env_texture_size>
                    </lens>
                    <always_on>true</always_on>
                    <update_rate>30</update_rate>
                    <distortion>
                        <k1>-0.007419134024530649</k1>
                        <k2>0.041209351271390915</k2>
                        <p1>-0.03811917081475258</p1>
                        <p2>0.006366158835589886</p2>
                        <k3>0.0</k3>
                    </distortion>
                </camera>

                <plugin name="${name}_${topic}_plugin" filename="libgazebo_ros_camera.so">
                    <ros>
                        <namespace>${namespace}</namespace>
                    </ros>

                    <always_on>true</always_on>
                    <camera_name>${name}/${topic}</camera_name>
                    <frame_name>${reference_frame}</frame_name>
                    <hack_baseline>-0.0</hack_baseline>
                    <focal_length>285.5480041503906</focal_length>
                    <cx>416.00531005859375</cx>
                    <cy>403.38909912109375</cy>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="sensor_t265" params="name:=t265 namespace:=vault parent base_link *origin">

        <xacro:include filename="$(find vault_description)/urdf/sensors/realsense/materials.urdf.xacro" />
        <xacro:property name="M_PI" value="3.1415926535897931" />

        <joint name="${namespace}_${name}_pose_frame_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${namespace}_${name}_pose_frame"/>
            <xacro:insert_block name="origin"/>
        </joint>

        <link name="${namespace}_${name}_pose_frame">
            <visual>
                <origin rpy="1.57 0 1.57" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://vault_description/meshes/sensors/realsense/t265.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="aluminum"/>
            </visual>
            <collision>
                <geometry>
                    <box size="0.013 0.108 0.024"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.055"/>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <inertia ixx="9.108e-05"
                        ixy="0"
                        ixz="0"
                        iyy="2.51e-06"
                        iyz="0"
                        izz="8.931e-05"/>
            </inertial>
        </link>

        <gazebo reference="${namespace}_${name}_pose_frame">
        <material>Gazebo/Silver</material>
        </gazebo>

        <joint name="${namespace}_${name}_joint" type="fixed">
            <parent link="${namespace}_${name}_pose_frame"/>
            <child link="${namespace}_${name}_link"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
        </joint>
        <link name="${namespace}_${name}_link"/>

        <joint name="${namespace}_${name}_fisheye1_joint" type="fixed">
            <parent link="${namespace}_${name}_link"/>
            <child link="${namespace}_${name}_fisheye1_frame"/>
            <origin rpy="${M_PI} 0 ${M_PI}" xyz="0 0.032 0"/>
        </joint>
        <link name="${namespace}_${name}_fisheye1_frame"/>

        <joint name="${namespace}_${name}_ligned_depth_to_fisheye1_joint" type="fixed">
            <parent link="${namespace}_${name}_link"/>
            <child link="${namespace}_${name}_aligned_depth_to_fisheye1_frame"/>
            <origin rpy="${M_PI} 0 ${M_PI}" xyz="0 0.032 0"/>
        </joint>
        <link name="${namespace}_${name}_aligned_depth_to_fisheye1_frame"/>

        <joint name="${namespace}_${name}_fisheye1_optical_joint" type="fixed">
            <parent link="${namespace}_${name}_aligned_depth_to_fisheye1_frame"/>
            <child link="${namespace}_${name}_fisheye1_optical_frame"/>
            <origin rpy="${M_PI/2} 0 -${M_PI/2}" xyz="0 0 0"/>
        </joint>
        <link name="${namespace}_${name}_fisheye1_optical_frame"/>
        <xacro:t265_fisheye
            name="${name}"
            namespace="${namespace}"
            reference_frame="${namespace}_${name}_fisheye1_optical_frame"
            topic="fisheye1">
        </xacro:t265_fisheye>

        <joint name="${namespace}_${name}_fisheye2_joint" type="fixed">
            <parent link="${namespace}_${name}_link"/>
            <child link="${namespace}_${name}_fisheye2_frame"/>
            <origin rpy="${M_PI} 0 ${M_PI}" xyz="0 -0.032 0"/>
        </joint>
        <link name="${namespace}_${name}_fisheye2_frame"/>

        <joint name="${namespace}_${name}_fisheye2_optical_joint" type="fixed">
            <parent link="${namespace}_${name}_fisheye2_frame"/>
            <child link="${namespace}_${name}_fisheye2_optical_frame"/>
            <origin rpy="${M_PI/2} 0 -${M_PI/2}" xyz="0 0 0"/>
        </joint>
        <link name="${namespace}_${name}_fisheye2_optical_frame"/>
        <xacro:t265_fisheye
            name="${name}"
            namespace="${namespace}"
            reference_frame="${namespace}_${name}_fisheye2_optical_frame"
            topic="fisheye2">
        </xacro:t265_fisheye>

        <joint name="${namespace}_${name}_gyro_joint" type="fixed">
            <parent link="${namespace}_${name}_link"/>
            <child link="${namespace}_${name}_gyro_frame"/>
            <origin rpy="0 0 ${M_PI}" xyz="0 0.021 0"/>
        </joint>
        <link name="${namespace}_${name}_gyro_frame"/>

        <joint name="${namespace}_${name}_gyro_optical_joint" type="fixed">
            <parent link="${namespace}_${name}_gyro_frame"/>
            <child link="${namespace}_${name}_gyro_optical_frame"/>
            <origin rpy="${M_PI/2} 0 -${M_PI/2}" xyz="0 0 0"/>
        </joint>
        <link name="${namespace}_${name}_gyro_optical_frame"/>

        <joint name="${namespace}_${name}_accel_joint" type="fixed">
            <parent link="${namespace}_${name}_link"/>
            <child link="${namespace}_${name}_accel_frame"/>
            <origin rpy="0 0 ${M_PI}" xyz="0 0.021 0"/>
        </joint>
        <link name="${namespace}_${name}_accel_frame"/>

        <joint name="${namespace}_${name}_accel_optical_joint" type="fixed">
            <parent link="${namespace}_${name}_accel_frame"/>
            <child link="${namespace}_${name}_accel_optical_frame"/>
            <origin rpy="${M_PI/2} 0 -${M_PI/2}" xyz="0 0 0"/>
        </joint>
        <link name="${namespace}_${name}_accel_optical_frame"/>

        <joint name="${namespace}_${name}_imu_joint" type="fixed">
            <parent link="${namespace}_${name}_link"/>
            <child link="${namespace}_${name}_imu_frame"/>
            <origin rpy="0 0 ${M_PI}" xyz="0 0.021 0"/>
        </joint>
        <link name="${namespace}_${name}_imu_frame"/>

        <joint name="${namespace}_${name}_imu_optical_joint" type="fixed">
            <parent link="${namespace}_${name}_imu_frame"/>
            <child link="${namespace}_${name}_imu_optical_frame"/>
            <origin rpy="${M_PI/2} 0 -${M_PI/2}" xyz="0 0 0"/>
        </joint>
        <link name="${namespace}_${name}_imu_optical_frame"/>

        <gazebo reference="${namespace}_${name}_imu_optical_frame">
            <gravity>true</gravity>
            <sensor name="${name}_imu_plugin" type="imu">
                <always_on>true</always_on>
                <update_rate>200</update_rate>
                <visualize>false</visualize>
                <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
                    <ros>
                        <namespace>${namespace}</namespace>
                        <remapping>~/out:=${name}/imu</remapping>
                    </ros>
                    <frame_name>${namespace}_${name}_imu_optical_frame</frame_name>
                </plugin>

                <imu>      
                    <angular_velocity>
                    <x>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        <bias_mean>0.0000075</bias_mean>
                        <bias_stddev>0.0000008</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        <bias_mean>0.0000075</bias_mean>
                        <bias_stddev>0.0000008</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        <bias_mean>0.0000075</bias_mean>
                        <bias_stddev>0.0000008</bias_stddev>
                        </noise>
                    </z>
                    </angular_velocity>
                    <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </z>
                    </linear_acceleration>
                </imu>

            </sensor>
        </gazebo>

        <!-- odom -->
        <gazebo>
            <plugin name="${name}_p3d_plugin" filename="libgazebo_ros_p3d.so">
                <ros>
                    <namespace>${namespace}</namespace>
                    <remapping>odom:=${name}/pose/sample</remapping>
                </ros>
      
                <always_on>true</always_on>
                <body_name>${base_link}</body_name>
                <frame_name>odom</frame_name>
                <update_rate>200</update_rate>
                <xyz_offset>0 0 0</xyz_offset>
                <rpy_offset>0 0 0</rpy_offset>
                <gaussian_noise>0</gaussian_noise>
            </plugin>
        </gazebo>

    </xacro:macro>

</robot>