<?xml version="1.0" ?>

<robot name="vault" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:macro name="vault" params="parent *origin">
        <!-- Include macros -->
        <xacro:include filename="$(find vault_description)/urdf/inertials.xacro"/>
        <xacro:include filename="$(find vault_description)/urdf/box/box.urdf.xacro" />
        <xacro:include filename="$(find vault_description)/urdf/box/cover.urdf.xacro" />
        <xacro:include filename="$(find vault_description)/urdf/box/realsense_mount.urdf.xacro" />
        <xacro:include filename="$(find vault_description)/urdf/box/computer.urdf.xacro" />
        <xacro:include filename="$(find vault_description)/urdf/box/battery.urdf.xacro" />
        <xacro:include filename="$(find vault_description)/urdf/sensors/all_sensors.urdf.xacro" />
    
        <!-- joint to base -->
        <joint name="vault_base_joint" type="fixed">
            <axis xyz="1 0 0"/>
            <xacro:insert_block name="origin"/>
            <parent link="${parent}"/>
            <child link="vault_base_link"/>
        </joint>

        <!-- The base link -->
        <link name="vault_base_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <box size="0.01 0.01 0.01"/>
                </geometry>
                <material name="orange" />
            </visual>
        </link>

        <gazebo reference="vault_base_link">
            <material>Gazebo/Orange</material>
        </gazebo>

        <!-- box -->
        <xacro:vault_box parent="vault_base_link" />
        <xacro:vault_cover parent="vault_box_link" />
        <xacro:vault_realsense_mount parent="vault_box_link" />
        <xacro:vault_computer parent="vault_box_link" />
        <xacro:vault_battery parent="vault_box_link" />

        <!-- sensors -->
        <xacro:arg name="use_nominal_extrinsics" default="true" />
        <xacro:sensor_d435i parent="vault_realsense_mount_link" name="vault_camera" use_nominal_extrinsics="$(arg use_nominal_extrinsics)">
            <origin xyz="0 -0.005 -0.0075" rpy="0 0 -1.57"/>
        </xacro:sensor_d435i>

        <!-- <xacro:sensor_t265 name="vault_camera" parent="vault_realsense_mount_link" rate="30">
            <origin xyz="0 -0.01 0.0075" rpy="0 0 -1.57"/>
        </xacro:sensor_t265> -->

        <xacro:sensor_imu name="vault_imu" parent="vault_box_link">
            <origin xyz="0 -0.075 0.084" rpy="0 -3.141516 0"/>
        </xacro:sensor_imu>

        <xacro:sensor_gps name="vault_gps" parent="vault_box_link">
            <origin xyz="0 0 0.1075" rpy="0 0 0"/>
        </xacro:sensor_gps>
        <xacro:gps_board name="vault_gps" parent="vault_box_link">
            <origin xyz="-0.077 0 -0.010" rpy="0 1.57 0"/>
        </xacro:gps_board>
    </xacro:macro>
</robot>